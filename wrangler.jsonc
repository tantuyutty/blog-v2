{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-v2",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "blog.tantuyu.dev",
      "custom_domain": true,
    },
    {
      "pattern": "tantuyu.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
