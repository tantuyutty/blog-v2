---
import type { HTMLAttributes } from "astro/types";

type BadgeVariant = "none" | "tag" | "category";

type Props = HTMLAttributes<"span"> & {
  variant?: BadgeVariant;
};

const { class: className, variant = "none", ...props } = Astro.props;
---

<span data-slot="badge" data-variant={variant} class={className} {...props}>
  <slot />
</span>

<style>
  [data-slot="badge"][data-variant="tag"],
  [data-slot="badge"][data-variant="category"] {
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.025em;
  }

  [data-slot="badge"][data-variant="tag"] {
    border: 1px solid var(--border);
    border-radius: 0.125rem;
    background: var(--secondary);
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
  }

  [data-slot="badge"][data-variant="category"] {
    border-radius: 9999px;
    background: var(--primary);
    color: var(--primary-foreground);
  }
</style>
