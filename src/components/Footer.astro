---
import { Image } from "astro:assets";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import { socialLinks } from "@/data/social-links";
import avatar from "@/assets/avatar.webp";

const navLinks = [
  { href: "/", label: "首頁" },
  { href: "/blog", label: "文章" },
  { href: "/about", label: "關於" },
];

const SITE_STARTED_AT = new Date("2026-01-29T17:45:00+08:00").getTime();
const HOUR_IN_MS = 60 * 60 * 1000;

function formatSiteUptime(now = Date.now()): string {
  const elapsedHours = Math.max(
    0,
    Math.floor((now - SITE_STARTED_AT) / HOUR_IN_MS),
  );
  const days = Math.floor(elapsedHours / 24);
  const hours = elapsedHours % 24;
  return `本站存活時間：${days} 天 ${hours} 小時`;
}

const siteUptime = formatSiteUptime();
---

<footer class="mt-auto w-full">
  <!-- hatched divider -->
  <div class="h-4 w-full border-t border-b [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"></div>

  <!-- main footer body -->
  <div class="">
    <div class="mx-auto flex max-w-6xl flex-row justify-between gap-4 px-4 py-10 md:px-8">
      <!-- mx-auto w-full max-w-6xl px-4 py-12  -->
      <div class="flex flex-col gap-4">
        <!-- brand -->
        <div class="flex flex-col gap-1">
          <a
            href="/"
            class="text-foreground w-fit font-mono text-lg font-semibold tracking-tight transition-opacity hover:opacity-70"
          >
            <h2>{SITE_TITLE}</h2>
          </a>
          <p class="text-muted-foreground max-w-48 text-xs leading-relaxed">
            {SITE_DESCRIPTION}
          </p>
        </div>

        <!-- nav -->
        <div class="flex flex-col items-start">
          <span class="text-muted-foreground text-center text-xs font-semibold tracking-widest uppercase">
            Pages
          </span>
          <ul class="flex h-fit flex-row gap-3">
            {navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-foreground/70 hover:text-foreground text-sm underline-offset-4 transition-colors hover:underline"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- social -->
        <div class="flex flex-col items-start gap-1">
          <span class="text-muted-foreground text-xs font-semibold tracking-widest uppercase">
            Connect
          </span>
          <ul class="flex flex-row gap-3">
            {socialLinks.map(({ href, label, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-link text-foreground/70 hover:text-foreground gap-1 text-sm underline-offset-4 transition-colors hover:underline"
              >
                <li class="flex items-center gap-1">
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-4"
                    aria-hidden="true"
                  >
                    <path d={icon.path}></path>
                  </svg>
                  {label}
                </li>
              </a>
            ))}
          </ul>
        </div>
      </div>

      <div class="flex items-end gap-4">
        <Image
          src={avatar}
          alt="avatar"
          width={1200}
          height={1200}
          class="footer-avatar aspect-square w-35 rotate-12 opacity-33 select-none"
          draggable="false"
        />
      </div>
    </div>
    <!-- bottom bar -->
    <div class="border-t">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-4 p-4 md:px-8">
        <p class="text-muted-foreground font-mono text-xs">
          &copy; {new Date().getFullYear()} {SITE_TITLE}
        </p>
        <div class="text-muted-foreground text-xs flex items-center gap-2">
          <span class="tabular-nums" data-site-uptime>
            {siteUptime}
          </span>
          <button
            type="button"
            data-music-player-open
            aria-controls="floating-music-player"
            class="text-muted-foreground hover:text-foreground cursor-pointer underline-offset-4 transition-colors hover:underline"
          >
            聽聽歌
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const SITE_STARTED_AT = new Date("2026-01-29T17:45:00+08:00").getTime();
  const HOUR_IN_MS = 60 * 60 * 1000;

  let siteUptimeTimer: number | undefined;

  function formatSiteUptime(now = Date.now()): string {
    const elapsedHours = Math.max(
      0,
      Math.floor((now - SITE_STARTED_AT) / HOUR_IN_MS),
    );
    const days = Math.floor(elapsedHours / 24);
    const hours = elapsedHours % 24;
    return `本站存活時間：${days} 天 ${hours} 小時`;
  }

  function updateSiteUptime() {
    const elements =
      document.querySelectorAll<HTMLElement>("[data-site-uptime]");
    const elapsed = Math.max(0, Date.now() - SITE_STARTED_AT);

    elements.forEach((element) => {
      element.textContent = formatSiteUptime();
    });

    window.clearTimeout(siteUptimeTimer);
    if (elements.length > 0) {
      siteUptimeTimer = window.setTimeout(
        updateSiteUptime,
        HOUR_IN_MS - (elapsed % HOUR_IN_MS),
      );
    }
  }

  updateSiteUptime();
  document.addEventListener("astro:page-load", updateSiteUptime);
</script>

<style>
  .footer-avatar {
    -webkit-mask-image: radial-gradient(circle, black 33%, transparent 70%);
    mask-image: radial-gradient(circle, black 33%, transparent 70%);
  }
</style>
