---
import { Image } from "astro:assets";
import { MoveUpRight } from "@lucide/astro";

import { GitHubIcon } from "@/components/icons/brands";
import type { Project } from "@/data/projects";
import Badge from "../ui/Badge.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-cover">
    <Image
      src={project.cover}
      alt=""
      widths={[640, 960, 1200]}
      sizes="(min-width: 768px) 58vw, 90vw"
      loading="lazy"
    />
  </div>

  <div class="project-copy">
    <div class="project-meta">
      <span>{project.type}</span>
      <time datetime={project.year}>{project.year}</time>
    </div>

    <h3>{project.name}</h3>
    <p>{project.description}</p>

    <ul aria-label={`${project.name} 使用技術`}>
      {project.technologies.map((technology) => (
        <li>
          <Badge variant="tag">{technology}</Badge>
        </li>
      ))}
    </ul>

    <a
      class="project-link"
      href={project.repositoryUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`在 GitHub 查看 ${project.name}（在新分頁開啟）`}
    >
      <span aria-hidden="true">
        <GitHubIcon className="github-icon" />
      </span>
      <span>查看 GitHub</span>
      <MoveUpRight class="external-icon" aria-hidden="true" />
    </a>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: 1.5rem 0;
  }

  .project-cover {
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--border) 82%, transparent);
    border-radius: 0.75rem;
    background: var(--card);
  }

  .project-cover :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: inherit;
    object-fit: cover;
    object-position: center top;
  }

  .project-copy {
    min-width: 0;
    text-align: left;
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1.4;
  }

  .project-meta time {
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: 0.65rem 0 0;
    color: var(--foreground);
    font-family: var(--font-noto-serif);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.35;
  }

  p {
    margin: 0.75rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 1.25rem;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .project-link .external-icon {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--muted-foreground);
    transition: transform 160ms ease;
  }

  .project-link:hover .external-icon {
    transform: translate(0.125rem, -0.125rem);
  }

  .project-link:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  @media (max-width: 47.999rem) {
    .project-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-link .external-icon {
      transition: none;
    }
  }
</style>
